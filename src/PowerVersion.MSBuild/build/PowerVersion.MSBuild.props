<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <SolutionVersionStrategy Condition="'$(SolutionVersionStrategy)' == ''">Git</SolutionVersionStrategy>
    <MainlineBranch Condition="'$(MainlineBranch)' == ''">master</MainlineBranch>
    <ReleaseBranchPrefix Condition="'$(ReleaseBranchPrefix)' == ''">release/</ReleaseBranchPrefix>
  </PropertyGroup>

</Project>
